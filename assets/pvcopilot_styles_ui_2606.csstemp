/* ===== PV Copilot — Dash styling (Apple "liquid glass", pale blue/yellow) ===== */
@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap');

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: 'Archivo', system-ui, sans-serif;
  color: #1c2540;
  background: linear-gradient(135deg, #dbe8ff 0%, #eef4fd 42%, #fdf6e3 100%);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
a { color: #2f6bff; text-decoration: none; }
a:hover { color: #1f52d6; }
::selection { background: rgba(79,139,255,0.25); }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: rgba(120,140,180,0.35); border-radius: 20px; border: 3px solid transparent; background-clip: content-box; }
input:focus-visible, button:focus-visible { outline: 2px solid #4f8bff; outline-offset: 2px; }
button { font-family: 'Archivo', sans-serif; }

/* blurred PV-array background layer */
.bg-layer { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
.bg-photo {
  position: absolute; inset: -40px;
  background-image: url('/assets/pv-array.png');
  background-size: cover; background-position: center 62%;
  filter: blur(26px) saturate(1.18); transform: scale(1.08);
}
.bg-veil { position: absolute; inset: 0; background: linear-gradient(150deg, rgba(219,232,255,0.7), rgba(238,244,253,0.58) 46%, rgba(253,246,227,0.72)); }
.bg-glow { position: absolute; inset: 0; background: radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,0.4), rgba(255,255,255,0) 60%); }

.shell { position: relative; z-index: 1; max-width: 1080px; margin: 0 auto; padding: 26px 32px 90px; }
.shell-narrow { max-width: 1000px; }

/* glass surfaces */
.glass {
  background: linear-gradient(135deg, rgba(255,255,255,0.66), rgba(255,255,255,0.44));
  backdrop-filter: blur(30px) saturate(1.5); -webkit-backdrop-filter: blur(30px) saturate(1.5);
  border: 1px solid rgba(255,255,255,0.72);
  box-shadow: 0 14px 44px rgba(30,58,120,0.11), inset 0 1px 0 rgba(255,255,255,0.6);
  border-radius: 28px;
}
.glass-soft { background: rgba(255,255,255,0.42); border: 1px solid rgba(255,255,255,0.7); border-radius: 24px; }

/* nav */
.nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 34px; }
.nav-pills {
  display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: 15px;
  background: rgba(255,255,255,0.5); backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4);
  border: 1px solid rgba(255,255,255,0.7); box-shadow: 0 6px 20px rgba(30,58,120,0.08);
}
.nav-pill { padding: 8px 16px; border-radius: 11px; font-size: 14px; font-weight: 600; color: #374466; }
.nav-pill.active { color: #2f6bff; background: rgba(79,139,255,0.12); font-weight: 700; }

/* buttons */
.btn-primary {
  display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border: none; border-radius: 14px;
  background: linear-gradient(135deg, #4b8bff, #2f6bff); color: #fff; font-weight: 700; font-size: 15px;
  cursor: pointer; box-shadow: 0 10px 26px rgba(47,107,255,0.34);
}
.btn-primary:hover { filter: brightness(1.05); }
.btn-run {
  display: inline-flex; align-items: center; gap: 9px; padding: 14px 24px; border: none; border-radius: 14px;
  background: linear-gradient(135deg, #4b8bff, #2f6bff); color: #fff; font-weight: 700; font-size: 14.5px;
  cursor: pointer; box-shadow: 0 10px 26px rgba(47,107,255,0.34);
}
.btn-run:hover { filter: brightness(1.05); }
.btn-run:disabled { filter: grayscale(0.4) opacity(0.6); cursor: not-allowed; box-shadow: none; }

/* animations */
@keyframes riseIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideIn { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
@keyframes pulseDot { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
.rise { animation: riseIn .45s ease both; }

/* live status "working" pulse */
.working-dot { display:inline-block; width:8px; height:8px; border-radius:50%;
  background:#2f6bff; margin-right:9px; animation: pulseDot 1s ease-in-out infinite; }

/* dcc.Upload dropzone reset */
#upload-data .upload-inner { cursor: pointer; }

/* identified-variable mapping chips (new-UI styling of the old dmc mapping table) */
.varmap-chip {
  display:flex; align-items:center; gap:10px; padding:11px 14px; border-radius:13px;
  background: rgba(255,255,255,0.58); border: 1px solid rgba(255,255,255,0.7);
}
.varmap-role { font-size:12px; font-weight:700; color:#5a6784; letter-spacing:.02em; }
.varmap-col  { font-size:13px; font-weight:700; color:#1c2540; font-family:'JetBrains Mono',monospace; }
.pill-note { color:#57606a; background:#f1f3f5; border:1px solid #d7dce0; }
.pill-warn { color:#8a6d00; background:#fff6e0; border:1px solid #f0dfa8; }
.pill { font-size:10.5px; font-weight:600; line-height:1; letter-spacing:.01em;
  border-radius:980px; padding:3px 8px; white-space:nowrap; }

/* keep Plotly graphs transparent so they sit on the glass */
.js-plotly-plot, .plot-container { background: transparent !important; }

/* remove Dash default undo/redo footer */
._dash-undo-redo { display: none; }

/* responsive new-layout rules (kept in assets for Dash versions without html.Style) */
@media (max-width: 860px) {
  .pvcopilot-shell { display:flex !important; flex-direction:column !important; gap:18px !important; }
  .pvcopilot-shell > * { width:100% !important; }
  #sidebar-render > div { width:100% !important; position:static !important; }
  .pvcopilot-shell .nav { flex-wrap:wrap !important; margin-bottom:0 !important; }
}
@media (max-width: 600px) {
  .pvcopilot-shell .nav-pills { display:none !important; }
  .pvcopilot-shell h1 { font-size:34px !important; }
}
